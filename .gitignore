# Local toolchain and redirected caches (resource-governance.md section 1).
# These live on M:\ by policy and must never be committed.
.venv/
.cache/
.tools/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Raw corpus: large binaries stay local, small text fixtures are tracked.
data/raw_docs/*.pdf
data/raw_docs/*.png
data/raw_docs/*.jpg
data/raw_docs/*.jpeg
data/raw_docs/*.tif
data/raw_docs/*.tiff

# Vector store is regenerated by scripts/ingest.py (Phase 2).
data/chroma_db/

# Local environment overrides
.env

# Embedding model cache downloaded by the containerised rag_server
data/.fastembed/

# Rendered from design/index.html, which is the single self-contained source.
# The extracted SVG is committed deliberately so GitHub can preview the diagram
# and the README can embed it; the raster is not. Regenerate both with
# scripts/render-design.sh - see design/README.md.
design/architecture.png
