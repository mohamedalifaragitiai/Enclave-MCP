# Copy to .env and set real values. .env is gitignored; this template is not.
#
#   cp .env.example .env
#
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum length is enforced by the servers (16 chars); they refuse to start
# below it rather than running unauthenticated.

RAG_API_KEY=change-me-generate-a-real-key
DOCS_API_KEY=change-me-generate-a-real-key

# Windows host address as seen from the DockerEngine distro - where the port
# proxy from scripts/setup-llm-proxy.ps1 listens and forwards to llama-server on
# 127.0.0.1:8001. Check with, inside the distro:
#     ip route show default | awk '{print $3}'
# This can change after a reboot or `wsl --shutdown`.
WSL_HOST_IP=172.28.64.1

# Must match --alias on the running llama-server (resource-governance.md
# section 3 - exactly one LLM instance, on port 8001).
LLM_MODEL=Qwen3-4B-Instruct-2507
